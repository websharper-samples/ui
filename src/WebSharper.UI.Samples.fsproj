<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>WebSharper.UI.Samples</AssemblyName>
    <RootNamespace>WebSharper.UI.Samples</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Utilities.fs" />
    <Compile Include="Charts.fs" />
    <Compile Include="SiteCommon.fs" />
    <Compile Include="Samples.fs" />
    <Compile Include="VarPlayground.fs" />
    <Compile Include="CollectionsSuite.fs" />
    <Compile Include="InputInspector.fs" />
    <Compile Include="ChartLab.fs" />
    <Compile Include="MiniSite.fs" />
    <Compile Include="TodoApp.fs" />
    <Compile Include="CommunityBoard.fs" />
    <Compile Include="Dashboard.fs" />
    <Compile Include="KanbanBoard.fs" />
    <Compile Include="ExpenseTracker.fs" />
    <Compile Include="DataExplorer.fs" />
    <Compile Include="GameOfLife.fs" />
    <Compile Include="OnboardingFlow.fs" />
    <Compile Include="Site.fs" />
    <Compile Include="Client.fs" />
    <None Include="InputTransformTemplate.html" />
    <None Include="package.json" />
    <None Include="esbuild.config.mjs" />
    <None Include="wsconfig.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WebSharper" Version="10.1.10.687" />
    <PackageReference Include="WebSharper.FSharp" Version="10.1.10.687" />
    <PackageReference Include="WebSharper.UI" Version="10.1.8.687" />
  </ItemGroup>

  <Target Name="ESBuildBundle" AfterTargets="WebSharperCompile" Condition=" '$(Configuration)' == 'Release' ">
    <Exec Command="npm install" />
    <Exec Command="node ./esbuild.config.mjs" />
  </Target>

</Project>